# Copy this file to .env and fill in your values.
GEMINI_API_KEY=your_api_key_here

# Optional
# GEMINI_MODEL=gemini-2.5-flash
# API_KEY=choose_a_long_random_string   # if set, clients must send it in the X-API-Key header
# DATABASE_URL=sqlite:///reviews.db
# SQL_ECHO=false                        # true prints every SQL query (including submitted code) to the log
